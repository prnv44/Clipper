# Copy this file to .env and fill in your credentials.

# --- Gemini: highlight selection + captions -------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_MODEL_FALLBACKS=gemini-2.5-flash,gemini-3.1-flash-lite,gemini-flash-latest
# GEMINI_MIN_INTERVAL_SECONDS=20
# GEMINI_SELECTION_CHUNK_CHARS=18000

# --- Instagram -------------------------------------------------------------
IG_USERNAME=your_instagram_username
IG_PASSWORD=your_instagram_password
# IG_2FA_CODE=

# --- Quality ---------------------------------------------------------------
# highest (default): CRF 15, medium preset, 256k audio.
QUALITY=highest
# SOURCE_MAX_HEIGHT=2160
# SOURCE_LONG_THRESHOLD_MINUTES=10
# SOURCE_MAX_HEIGHT_LONG=1440
# SOURCE_MAX_HEIGHT_SHORT=2160
# QUALITY=high is faster and uses lighter source downloads.
# X264_PRESET=veryfast       # high alone still uses medium; veryfast saves CPU

# --- Automatic podcast highlights -----------------------------------------
# AUTO_CLIP_MODE=content     # content (default) or legacy duration estimate
# AUTO_MAX_CLIPS=40          # discovery ceiling, not a requested count
# AUTO_CANDIDATES_PER_CHUNK=10
# AUTO_CLIP_DENSITY_MINUTES=10  # only used by duration mode

# --- Condensed story parts (python -m ziv.parts / ./ziv.sh parts) ------------
# PARTS_MODE=story          # story or number-only
# PARTS_TARGET_SECONDS=60    # cuts prefer nearby sentence/scene boundaries
# PARTS_BACKGROUND=blur     # blur (default) or plain (lighter)
# SUB_STYLE=hormozi
# SUB_LANG=

# --- Whisper subtitles -----------------------------------------------------
# tiny (default), base, or small
# WHISPER_MODEL=tiny
# WHISPER_COMPUTE=int8
# WHISPER_THREADS=2
# SUB_FONT=Arial
# SUBTITLE_SOURCE=auto       # auto: YouTube/local captions, then Whisper
# ANALYSIS_MAX_FRAMES=12     # sparse visual fallback samples; lower for weaker CPUs
# FFMPEG_THREADS=2           # decoder, filters, and final encoding pools
# AUDIO_NORMALIZATION=true
# MAKE_COVERS=false

# --- Instagram posting schedule -------------------------------------------
# Only scheduled posting uses this window. `ziv post` posts now.
# POST_HOURS=17-0
# QUEUE_MIN_GAP_MINUTES=60
# QUEUE_MAX_GAP_MINUTES=120
# QUEUE_MAX_ATTEMPTS=3

# --- Paths -----------------------------------------------------------------
# OUTPUT_DIR=output
# LINKS_FILE=links.txt
# CHANNELS_FILE=channels.txt
# IG_SESSION_FILE=.ig_session
# STATE_DIR=.ziv-state

# --- Channel discovery -----------------------------------------------------
# CHANNEL_SCAN_MAX=0       # 0 = inspect every available channel video
# CHANNEL_CACHE_HOURS=24
# CHANNEL_BACKLOG_MAX=20    # active, unprocessed links allowed from discovery
# MAKE_MAX_SOURCES=2       # sources processed by one make invocation
# QUEUE_MAX_PENDING=12     # rendering batch capacity; full selection is saved
# CHANNELS_FILE=channels.txt

# --- Disposable media cleanup -----------------------------------------------
# These remove only confirmed/generated media. Queue history and manifests stay.
DELETE_SOURCE_AFTER_CLIP=false
DELETE_POSTED_CLIPS=false

# --- Optional desktop notifications -----------------------------------------
# Native notifications are best-effort; terminal output remains the fallback.
# DESKTOP_NOTIFICATIONS=false

# --- YouTube download authentication (for links.txt/channels.txt) ----------
# Set ONE after signing into YouTube and closing the browser:
# YTDLP_COOKIES_FROM_BROWSER=firefox
# YTDLP_COOKIES_FROM_BROWSER=brave
# YTDLP_COOKIES_FROM_BROWSER=chrome:Profile 1
# Or use a fresh Netscape/Mozilla export:
# YTDLP_COOKIES_FILE=/absolute/path/to/cookies.txt
# SOURCE_SUB_LANGS=en,en-US,en-GB
